{
  "routes": [
    { "route": "/api/*", "allowedRoles": ["authenticated"] },
    { "route": "/login", "redirect": "/.auth/login/aad?post_login_redirect_uri=/" },
    { "route": "/logout", "redirect": "/.auth/logout" }
  ],
  "responseOverrides": { "401": { "redirect": "/login", "statusCode": 302 } }
}
